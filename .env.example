NODE_ENV=production
PORT=3000
HOST=127.0.0.1
SITE_URL=https://example.ru
BASEURL=
CMS_ADMIN_EMAIL=owner@example.ru
CMS_ADMIN_PASSWORD=replace-with-a-long-password
CMS_SESSION_SECRET=replace-with-at-least-32-random-characters
CMS_SECURE_COOKIE=1
CMS_TRUST_PROXY=1
CMS_DB_PATH=./data/cms.sqlite
CMS_MEDIA_DIR=./media/uploads
CMS_BACKUP_DIR=./backups
CMS_BACKUP_KEEP=14
LEAD_EMAIL_TO=owner@example.ru
LEAD_DELIVERY=sendmail
SENDMAIL_PATH=/usr/sbin/sendmail
SMTP_FROM=site@example.ru
